# CrocoTV 本地套件唯一的服务端环境模板。
# 复制为 .codex/.env；不要提交真实密钥。相对路径均以 CrocoTV 仓库根目录为基准。

# Local runtime
LOCAL_API_PORT=4399
CROCO_DATA_DIR=./data
GENERATION_MAX_CONCURRENCY=5
FFMPEG_PATH=ffmpeg

# Volcano Engine Ark: LLM and tone planning
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_MODEL=doubao-seed-2-1-turbo-260628
TTS_TONE_MODEL=deepseek-v4-flash-260425

# BigModel
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
BIGMODEL_API_KEY=

# Runware image/LLM generation
RUNWARE_BASE_URL=https://api.runware.ai/v1
RUNWARE_API_KEY=

# Doubao speech synthesis and recognition
DOUBAO_TTS_BASE_URL=https://openspeech.bytedance.com/api/v3
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_RESOURCE_ID=
DOUBAO_ASR_BASE_URL=https://openspeech.bytedance.com/api/v3
DOUBAO_ASR_API_KEY=
DOUBAO_ASR_RESOURCE_ID=
VOLCENGINE_ASR_API_KEY=

# MiniMax H3 local/private endpoint
H3_BASE_URL=
H3_API_KEY=

# Alibaba Bailian Happy Horse
HAPPYHORSE_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
HAPPYHORSE_API_KEY=
DASHSCOPE_API_KEY=

# Suno
SUNO_BASE_URL=https://api.sunoapi.org
SUNO_API_KEY=
SUNO_MODEL=V4_5ALL

# CrocoBack published character catalog
CROCO_CHARACTERS_API_URL=
CROCO_CHARACTERS_API_TOKEN=

# Optional public temporary-asset broker for providers that cannot read local files
CROCO_TEMP_ASSET_BROKER_URL=
CROCO_TEMP_ASSET_CLIENT_TOKEN=
